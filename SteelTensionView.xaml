<UserControl x:Class="SpectrumComparison.SteelTensionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:SpectrumComparison"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1200">

    <UserControl.DataContext>
        <local:SteelTensionViewModel/>
    </UserControl.DataContext>

    <Grid Background="{StaticResource FluentBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left: Input Parameters -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="16">
            <StackPanel>
                <TextBlock Text="AISC 360-16 构件抗拉验算" Style="{StaticResource SectionTitleStyle}"/>

                <!-- Section Selection -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Section Selection" Style="{StaticResource StrongLabelStyle}" FontSize="14" Margin="0,0,0,12"/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Section Type:" Style="{StaticResource LabelStyle}" Grid.Column="0"/>
                            <ComboBox ItemsSource="{Binding SectionTypeOptions}" SelectedIndex="{Binding SectionTypeIndex}"
                                      Style="{StaticResource FluentComboBoxStyle}" Grid.Column="1"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Data Source:" Style="{StaticResource LabelStyle}" Grid.Column="0"/>
                            <ComboBox ItemsSource="{Binding SectionSourceOptions}" SelectedIndex="{Binding SectionSourceIndex}"
                                      Style="{StaticResource FluentComboBoxStyle}" Grid.Column="1"/>
                        </Grid>

                        <!-- Database shape selection -->
                        <Grid Margin="0,0,0,4" Visibility="{Binding IsDatabase, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Shape:" Style="{StaticResource LabelStyle}" Grid.Column="0"/>
                            <ComboBox ItemsSource="{Binding ShapeOptions}" SelectedIndex="{Binding SelectedShapeIndex}"
                                      Style="{StaticResource FluentComboBoxStyle}" Grid.Column="1"/>
                        </Grid>

                        <!-- Custom I-Shape dimensions -->
                        <StackPanel Visibility="{Binding ShowIShapeCustom, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="d (in):" Style="{StaticResource LabelStyle}" Grid.Column="0"/>
                                <TextBox Text="{Binding CustomD, StringFormat=F3}" Style="{StaticResource FluentNumericStyle}" Grid.Column="1" Margin="0,0,8,0"/>
                                <TextBlock Text="bf (in):" Style="{StaticResource LabelStyle}" Grid.Column="2"/>
                                <TextBox Text="{Binding CustomBf, StringFormat=F3}" Style="{StaticResource FluentNumericStyle}" Grid.Column="3"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="tw (in):" Style="{StaticResource LabelStyle}" Grid.Column="0"/>
                                <TextBox Text="{Binding CustomTw, StringFormat=F3}" Style="{StaticResource FluentNumericStyle}" Grid.Column="1" Margin="0,0,8,0"/>
                                <TextBlock Text="tf (in):" Style="{StaticResource LabelStyle}" Grid.Column="2"/>
                                <TextBox Text="{Binding CustomTf, StringFormat=F3}" Style="{StaticResource FluentNumericStyle}" Grid.Column="3"/>
                            </Grid>
                        </StackPanel>

                        <!-- Custom HSS dimensions -->
                        <StackPanel Visibility="{Binding ShowHSSCustom, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Ht (in):" Style="{StaticResource LabelStyle}" Grid.Column="0"/>
                                <TextBox Text="{Binding CustomHt, StringFormat=F3}" Style="{StaticResource FluentNumericStyle}" Grid.Column="1" Margin="0,0,8,0"/>
                                <TextBlock Text="B (in):" Style="{StaticResource LabelStyle}" Grid.Column="2"/>
                                <TextBox Text="{Binding CustomB, StringFormat=F3}" Style="{StaticResource FluentNumericStyle}" Grid.Column="3"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="tdes (in):" Style="{StaticResource LabelStyle}" Grid.Column="0"/>
                                <TextBox Text="{Binding CustomT, StringFormat=F3}" Style="{StaticResource FluentNumericStyle}" Grid.Column="1"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Material Parameters -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Material Parameters" Style="{StaticResource StrongLabelStyle}" FontSize="14" Margin="0,0,0,12"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Fy (ksi):" Style="{StaticResource LabelStyle}" Grid.Column="0"/>
                            <TextBox Text="{Binding Fy, StringFormat=F1}" Style="{StaticResource FluentNumericStyle}" Grid.Column="1" Margin="0,0,8,0"/>
                            <TextBlock Text="Fu (ksi):" Style="{StaticResource LabelStyle}" Grid.Column="2"/>
                            <TextBox Text="{Binding Fu, StringFormat=F1}" Style="{StaticResource FluentNumericStyle}" Grid.Column="3"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Design Parameters -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Design Parameters" Style="{StaticResource StrongLabelStyle}" FontSize="14" Margin="0,0,0,12"/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Method:" Style="{StaticResource LabelStyle}" Grid.Column="0"/>
                            <ComboBox ItemsSource="{Binding MethodOptions}" SelectedIndex="{Binding MethodIndex}"
                                      Style="{StaticResource FluentComboBoxStyle}" Grid.Column="1"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Tu (kips):" Style="{StaticResource LabelStyle}" Grid.Column="0"/>
                            <TextBox Text="{Binding Tu, StringFormat=F2}" Style="{StaticResource FluentNumericStyle}" Grid.Column="1" Margin="0,0,8,0"/>
                            <TextBlock Text="Length (ft):" Style="{StaticResource LabelStyle}" Grid.Column="2"/>
                            <TextBox Text="{Binding MemberLength, StringFormat=F1}" Style="{StaticResource FluentNumericStyle}" Grid.Column="3"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Connection Parameters -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Connection Parameters" Style="{StaticResource StrongLabelStyle}" FontSize="14" Margin="0,0,0,12"/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Connection:" Style="{StaticResource LabelStyle}" Grid.Column="0"/>
                            <ComboBox ItemsSource="{Binding ConnectionCaseOptions}" SelectedIndex="{Binding ConnectionCaseIndex}"
                                      Style="{StaticResource FluentComboBoxStyle}" Grid.Column="1"/>
                        </Grid>

                        <!-- Connection length (for HSS gusset and I-shape Case 2) -->
                        <Grid Margin="0,0,0,8" Visibility="{Binding ShowConnectionLength, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Conn. Length l (in):" Style="{StaticResource LabelStyle}" Grid.Column="0"/>
                            <TextBox Text="{Binding ConnectionLength, StringFormat=F2}" Style="{StaticResource FluentNumericStyle}" Grid.Column="1"/>
                        </Grid>

                        <!-- Connection eccentricity x̄ (for I-shape Case 2) -->
                        <Grid Margin="0,0,0,4" Visibility="{Binding ShowXbar, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="x̄ (in):" Style="{StaticResource LabelStyle}" Grid.Column="0"/>
                            <TextBox Text="{Binding Xbar, StringFormat=F3}" Style="{StaticResource FluentNumericStyle}" Grid.Column="1"/>
                        </Grid>
                        <TextBlock Text="(Case 2: U = 1-x̄/l, optional; Case 7 auto from bf/d)"
                                   Visibility="{Binding ShowXbar, Converter={StaticResource BooleanToVisibilityConverter}}"
                                   Style="{StaticResource LabelStyle}" FontSize="11" Foreground="Gray" Margin="0,0,0,8"/>

                        <!-- User-defined U -->
                        <Grid Margin="0,0,0,8" Visibility="{Binding ShowUserU, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="U (shear lag):" Style="{StaticResource LabelStyle}" Grid.Column="0"/>
                            <TextBox Text="{Binding UserU, StringFormat=F4}" Style="{StaticResource FluentNumericStyle}" Grid.Column="1"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Net Area Parameters -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Net Area (An)" Style="{StaticResource StrongLabelStyle}" FontSize="14" Margin="0,0,0,12"/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="An method:" Style="{StaticResource LabelStyle}" Grid.Column="0"/>
                            <ComboBox SelectedIndex="{Binding UseAutoNetArea, Converter={StaticResource InverseBoolConverter}}"
                                      Style="{StaticResource FluentComboBoxStyle}" Grid.Column="1">
                                <ComboBoxItem Content="Auto (from bolt holes)"/>
                                <ComboBoxItem Content="Manual input"/>
                            </ComboBox>
                        </Grid>

                        <!-- Bolt hole inputs -->
                        <StackPanel Visibility="{Binding ShowBoltHoleInputs, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Bolt dia. (in):" Style="{StaticResource LabelStyle}" Grid.Column="0"/>
                                <TextBox Text="{Binding BoltHoleDiameter, StringFormat=F3}" Style="{StaticResource FluentNumericStyle}" Grid.Column="1" Margin="0,0,8,0"/>
                                <TextBlock Text="Num. holes:" Style="{StaticResource LabelStyle}" Grid.Column="2"/>
                                <TextBox Text="{Binding NumberOfHoles}" Style="{StaticResource FluentNumericStyle}" Grid.Column="3"/>
                            </Grid>
                        </StackPanel>

                        <!-- Manual An input -->
                        <Grid Visibility="{Binding ShowManualAn, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="An (in²):" Style="{StaticResource LabelStyle}" Grid.Column="0"/>
                            <TextBox Text="{Binding An, StringFormat=F3}" Style="{StaticResource FluentNumericStyle}" Grid.Column="1"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Calculate Button -->
                <Button Content="Start Check" Command="{Binding CalculateCommand}"
                        Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Stretch" Margin="0,0,0,16"/>

                <!-- Results Summary -->
                <Border Style="{StaticResource CardStyle}" Visibility="{Binding HasResult, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="Check Results" Style="{StaticResource StrongLabelStyle}" FontSize="14" Margin="0,0,0,12"/>

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Tension Ratio: " Style="{StaticResource LabelStyle}" Grid.Column="0"/>
                            <TextBlock Text="{Binding Ratio, StringFormat={}{0:F4}}" Style="{StaticResource StrongLabelStyle}" Grid.Column="1" Margin="0,0,12,0"/>
                            <TextBlock Text="{Binding TensionStatus}" FontWeight="Bold" FontSize="14" Grid.Column="2"/>
                        </Grid>

                        <TextBlock Text="{Binding ResultText}" TextWrapping="Wrap" Style="{StaticResource LabelStyle}" FontSize="12"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Right: Detailed Calculation Process -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="16">
            <StackPanel>
                <TextBlock Text="Detailed Calculation Process" Style="{StaticResource SectionTitleStyle}"/>

                <Border Style="{StaticResource CardStyle}">
                    <Border Background="#F5F5F5" BorderBrush="{StaticResource FluentBorderBrush}" BorderThickness="1"
                            CornerRadius="4" Padding="12">
                        <TextBox Text="{Binding ProcessText}"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 MinHeight="600"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 FontFamily="Consolas"
                                 FontSize="13"
                                 VerticalScrollBarVisibility="Auto"/>
                    </Border>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
