<UserControl x:Class="SpectrumComparison.SlottedwebView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:SpectrumComparison"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1200">

    <UserControl.DataContext>
        <local:SlottedwebViewModel/>
    </UserControl.DataContext>

    <Grid Background="{StaticResource FluentBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left: Input Parameters -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="16">
            <StackPanel>
                <TextBlock Text="AISC 358-16 SlottedWeb Connection Verification (Ch. 14)" Style="{StaticResource SectionTitleStyle}"/>

                <!-- Beam Section Card -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Beam Section" Style="{StaticResource StrongLabelStyle}" FontSize="14" Margin="0,0,0,12"/>

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Shape:" Style="{StaticResource LabelStyle}" Grid.Column="0"/>
                            <ComboBox ItemsSource="{Binding BeamShapeOptions}" SelectedIndex="{Binding SelectedBeamShapeIndex}"
                                      Style="{StaticResource FluentComboBoxStyle}" Grid.Column="1"/>
                        </Grid>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                <TextBlock Text="d (in):" Style="{StaticResource LabelStyle}"/>
                                <TextBox Text="{Binding BeamD, StringFormat=F3}" Style="{StaticResource FluentNumericStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,4,0">
                                <TextBlock Text="bf (in):" Style="{StaticResource LabelStyle}"/>
                                <TextBox Text="{Binding BeamBf, StringFormat=F3}" Style="{StaticResource FluentNumericStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Zx (in3):" Style="{StaticResource LabelStyle}"/>
                                <TextBox Text="{Binding BeamZx, StringFormat=F1}" Style="{StaticResource FluentNumericStyle}"/>
                            </StackPanel>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                <TextBlock Text="tf (in):" Style="{StaticResource LabelStyle}"/>
                                <TextBox Text="{Binding BeamTf, StringFormat=F3}" Style="{StaticResource FluentNumericStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,4,0">
                                <TextBlock Text="tw (in):" Style="{StaticResource LabelStyle}"/>
                                <TextBox Text="{Binding BeamTw, StringFormat=F3}" Style="{StaticResource FluentNumericStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="T (in, 0=auto):" Style="{StaticResource LabelStyle}"/>
                                <TextBox Text="{Binding BeamT, StringFormat=F2}" Style="{StaticResource FluentNumericStyle}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Column Section Card -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Column Section" Style="{StaticResource StrongLabelStyle}" FontSize="14" Margin="0,0,0,12"/>

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Shape:" Style="{StaticResource LabelStyle}" Grid.Column="0"/>
                            <ComboBox ItemsSource="{Binding ColShapeOptions}" SelectedIndex="{Binding SelectedColShapeIndex}"
                                      Style="{StaticResource FluentComboBoxStyle}" Grid.Column="1"/>
                        </Grid>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                <TextBlock Text="d (in):" Style="{StaticResource LabelStyle}"/>
                                <TextBox Text="{Binding ColD, StringFormat=F3}" Style="{StaticResource FluentNumericStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,4,0">
                                <TextBlock Text="bf (in):" Style="{StaticResource LabelStyle}"/>
                                <TextBox Text="{Binding ColBf, StringFormat=F3}" Style="{StaticResource FluentNumericStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Zx (in3):" Style="{StaticResource LabelStyle}"/>
                                <TextBox Text="{Binding ColZx, StringFormat=F1}" Style="{StaticResource FluentNumericStyle}"/>
                            </StackPanel>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                <TextBlock Text="tf (in):" Style="{StaticResource LabelStyle}"/>
                                <TextBox Text="{Binding ColTf, StringFormat=F3}" Style="{StaticResource FluentNumericStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="tw (in):" Style="{StaticResource LabelStyle}"/>
                                <TextBox Text="{Binding ColTw, StringFormat=F3}" Style="{StaticResource FluentNumericStyle}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Shear Plate Card -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Shear Plate" Style="{StaticResource StrongLabelStyle}" FontSize="14" Margin="0,0,0,12"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                <TextBlock Text="l_p override (in, 0=auto):" Style="{StaticResource LabelStyle}"/>
                                <TextBox Text="{Binding LpOverride, StringFormat=F2}" Style="{StaticResource FluentNumericStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Plate Fy (ksi):" Style="{StaticResource LabelStyle}"/>
                                <TextBox Text="{Binding PlateFy, StringFormat=F1}" Style="{StaticResource FluentNumericStyle}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Design Parameters Card -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Design Parameters" Style="{StaticResource StrongLabelStyle}" FontSize="14" Margin="0,0,0,12"/>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                <TextBlock Text="Span (in):" Style="{StaticResource LabelStyle}"/>
                                <TextBox Text="{Binding Span, StringFormat=F0}" Style="{StaticResource FluentNumericStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="System Type:" Style="{StaticResource LabelStyle}"/>
                                <TextBox Text="SMF" IsReadOnly="True" Style="{StaticResource FluentNumericStyle}" Background="#F0F0F0"/>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                <TextBlock Text="Story Above (in):" Style="{StaticResource LabelStyle}"/>
                                <TextBox Text="{Binding StoryAbove, StringFormat=F0}" Style="{StaticResource FluentNumericStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Story Below (in):" Style="{StaticResource LabelStyle}"/>
                                <TextBox Text="{Binding StoryBelow, StringFormat=F0}" Style="{StaticResource FluentNumericStyle}"/>
                            </StackPanel>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                <TextBlock Text="Pu (kips):" Style="{StaticResource LabelStyle}"/>
                                <TextBox Text="{Binding Pu, StringFormat=F0}" Style="{StaticResource FluentNumericStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="As_col (in2, 0=auto):" Style="{StaticResource LabelStyle}"/>
                                <TextBox Text="{Binding AsCol, StringFormat=F1}" Style="{StaticResource FluentNumericStyle}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Loads Card -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Gravity Loads" Style="{StaticResource StrongLabelStyle}" FontSize="14" Margin="0,0,0,12"/>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                <TextBlock Text="D (kips):" Style="{StaticResource LabelStyle}"/>
                                <TextBox Text="{Binding LoadD, StringFormat=F2}" Style="{StaticResource FluentNumericStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,4,0">
                                <TextBlock Text="L (kips):" Style="{StaticResource LabelStyle}"/>
                                <TextBox Text="{Binding LoadL, StringFormat=F2}" Style="{StaticResource FluentNumericStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="S (kips):" Style="{StaticResource LabelStyle}"/>
                                <TextBox Text="{Binding LoadS, StringFormat=F2}" Style="{StaticResource FluentNumericStyle}"/>
                            </StackPanel>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="f1 (live load factor):" Style="{StaticResource LabelStyle}"/>
                                <TextBox Text="{Binding F1, StringFormat=F2}" Style="{StaticResource FluentNumericStyle}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Material Properties Card -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Material Properties" Style="{StaticResource StrongLabelStyle}" FontSize="14" Margin="0,0,0,12"/>

                        <TextBlock Text="Beam:" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="{StaticResource FluentTextBrush}"/>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                <TextBlock Text="Fy (ksi):" Style="{StaticResource LabelStyle}"/>
                                <TextBox Text="{Binding BeamFy, StringFormat=F1}" Style="{StaticResource FluentNumericStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Fu (ksi):" Style="{StaticResource LabelStyle}"/>
                                <TextBox Text="{Binding BeamFu, StringFormat=F1}" Style="{StaticResource FluentNumericStyle}"/>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                <TextBlock Text="Ry:" Style="{StaticResource LabelStyle}"/>
                                <TextBox Text="{Binding BeamRy, StringFormat=F2}" Style="{StaticResource FluentNumericStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Rt:" Style="{StaticResource LabelStyle}"/>
                                <TextBox Text="{Binding BeamRt, StringFormat=F2}" Style="{StaticResource FluentNumericStyle}"/>
                            </StackPanel>
                        </Grid>

                        <Separator Margin="0,4"/>
                        <TextBlock Text="Column:" FontWeight="SemiBold" Margin="0,4,0,4" Foreground="{StaticResource FluentTextBrush}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Fy (ksi):" Style="{StaticResource LabelStyle}"/>
                                <TextBox Text="{Binding ColFy, StringFormat=F1}" Style="{StaticResource FluentNumericStyle}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Calculate Button -->
                <Button Content="Start Check" Command="{Binding CalculateCommand}"
                        Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Stretch" Margin="0,0,0,16"/>

                <!-- Results Summary Card -->
                <Border Style="{StaticResource CardStyle}" Visibility="{Binding HasResult, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="Check Results" Style="{StaticResource StrongLabelStyle}" FontSize="14" Margin="0,0,0,12"/>

                        <!-- Overall -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Overall: " Style="{StaticResource StrongLabelStyle}" Grid.Column="0"/>
                            <TextBlock Text="{Binding OverallStatus}" FontWeight="Bold" FontSize="14"
                                       Foreground="{Binding OverallStatusColor}" Grid.Column="1"/>
                        </Grid>

                        <!-- Key results -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="M_pr (kip-in):" Style="{StaticResource LabelStyle}"/>
                                <TextBlock Text="{Binding Mpr, StringFormat={}{0:F0}}" Style="{StaticResource StrongLabelStyle}" FontSize="13"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                <TextBlock Text="M_f (kip-in):" Style="{StaticResource LabelStyle}"/>
                                <TextBlock Text="{Binding Mf, StringFormat={}{0:F0}}" Style="{StaticResource StrongLabelStyle}" FontSize="13"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="0,0,16,0">
                                <TextBlock Text="V_beam (kips):" Style="{StaticResource LabelStyle}"/>
                                <TextBlock Text="{Binding Vbeam, StringFormat={}{0:F1}}" Style="{StaticResource StrongLabelStyle}" FontSize="13"/>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="l_s (in):" Style="{StaticResource LabelStyle}"/>
                                <TextBlock Text="{Binding Ls, StringFormat={}{0:F2}}" Style="{StaticResource StrongLabelStyle}" FontSize="13"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                <TextBlock Text="l_p (in):" Style="{StaticResource LabelStyle}"/>
                                <TextBlock Text="{Binding Lp, StringFormat={}{0:F2}}" Style="{StaticResource StrongLabelStyle}" FontSize="13"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="0,0,16,0">
                                <TextBlock Text="t_p (in):" Style="{StaticResource LabelStyle}"/>
                                <TextBlock Text="{Binding Tp, StringFormat={}{0:F3}}" Style="{StaticResource StrongLabelStyle}" FontSize="13"/>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="h (in):" Style="{StaticResource LabelStyle}"/>
                                <TextBlock Text="{Binding HPlate, StringFormat={}{0:F2}}" Style="{StaticResource StrongLabelStyle}" FontSize="13"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                <TextBlock Text="M_weld (kip-in):" Style="{StaticResource LabelStyle}"/>
                                <TextBlock Text="{Binding Mweld, StringFormat={}{0:F0}}" Style="{StaticResource StrongLabelStyle}" FontSize="13"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="0,0,16,0">
                                <TextBlock Text="V_weld (kips):" Style="{StaticResource LabelStyle}"/>
                                <TextBlock Text="{Binding Vweld, StringFormat={}{0:F1}}" Style="{StaticResource StrongLabelStyle}" FontSize="13"/>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="e_x (in):" Style="{StaticResource LabelStyle}"/>
                                <TextBlock Text="{Binding Ex, StringFormat={}{0:F2}}" Style="{StaticResource StrongLabelStyle}" FontSize="13"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                <TextBlock Text="l_b (in):" Style="{StaticResource LabelStyle}"/>
                                <TextBlock Text="{Binding Lb, StringFormat={}{0:F1}}" Style="{StaticResource StrongLabelStyle}" FontSize="13"/>
                            </StackPanel>
                        </Grid>

                        <Separator Margin="0,4"/>

                        <!-- Individual checks -->
                        <Grid Margin="0,4,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Prequalification" Style="{StaticResource LabelStyle}" Grid.Column="0"/>
                            <TextBlock Text="{Binding PrequalificationStatus}" FontWeight="Bold" Grid.Column="1"/>
                        </Grid>
                        <Grid Margin="0,2,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Shear Plate Design" Style="{StaticResource LabelStyle}" Grid.Column="0"/>
                            <TextBlock Text="{Binding ShearPlateStatus}" FontWeight="Bold" Grid.Column="1"/>
                        </Grid>
                        <Grid Margin="0,2,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Beam Shear" Style="{StaticResource LabelStyle}" Grid.Column="0"/>
                            <TextBlock Text="{Binding BeamShearStatus}" FontWeight="Bold" Grid.Column="1" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding BeamShearRatio, StringFormat='{}{0:F3}'}" Style="{StaticResource LabelStyle}" Grid.Column="2"/>
                        </Grid>
                        <Grid Margin="0,2,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Continuity Plates" Style="{StaticResource LabelStyle}" Grid.Column="0"/>
                            <TextBlock Text="{Binding ContinuityPlatesStatus}" FontWeight="Bold" Grid.Column="1"/>
                        </Grid>
                        <Grid Margin="0,2,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Panel Zone" Style="{StaticResource LabelStyle}" Grid.Column="0"/>
                            <TextBlock Text="{Binding PanelZoneStatus}" FontWeight="Bold" Grid.Column="1" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding PanelZoneRatio, StringFormat='{}{0:F3}'}" Style="{StaticResource LabelStyle}" Grid.Column="2"/>
                        </Grid>
                        <Grid Margin="0,2,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Column-Beam Moment Ratio" Style="{StaticResource LabelStyle}" Grid.Column="0"/>
                            <TextBlock Text="{Binding ColumnBeamRatioStatus}" FontWeight="Bold" Grid.Column="1" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding ColumnBeamRatio, StringFormat='{}{0:F3}'}" Style="{StaticResource LabelStyle}" Grid.Column="2"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Right: Detailed Calculation Process -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="16">
            <StackPanel>
                <TextBlock Text="Detailed Calculation Process" Style="{StaticResource SectionTitleStyle}"/>

                <Border Style="{StaticResource CardStyle}">
                    <Border Background="#F5F5F5" BorderBrush="{StaticResource FluentBorderBrush}" BorderThickness="1"
                            CornerRadius="4" Padding="12">
                        <TextBox Text="{Binding ProcessText}"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 MinHeight="600"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 FontFamily="Consolas"
                                 FontSize="13"
                                 VerticalScrollBarVisibility="Auto"/>
                    </Border>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
