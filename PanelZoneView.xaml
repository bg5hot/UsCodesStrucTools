<UserControl x:Class="SpectrumComparison.PanelZoneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:SpectrumComparison"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1200">

    <UserControl.DataContext>
        <local:PanelZoneViewModel/>
    </UserControl.DataContext>

    <Grid Background="{StaticResource FluentBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left: Input Parameters -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="16">
            <StackPanel>
                <TextBlock Text="AISC 341-16 §E3.6e + AISC 360-16 §J10.6 梁柱节点剪切区验算" Style="{StaticResource SectionTitleStyle}"/>

                <!-- Design Method & System -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Design Method &amp; System" Style="{StaticResource StrongLabelStyle}" FontSize="14" Margin="0,0,0,12"/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Method:" Style="{StaticResource LabelStyle}" Grid.Column="0"/>
                            <ComboBox ItemsSource="{Binding MethodOptions}" SelectedIndex="{Binding MethodIndex}"
                                      Style="{StaticResource FluentComboBoxStyle}" Grid.Column="1"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="System:" Style="{StaticResource LabelStyle}" Grid.Column="0"/>
                            <ComboBox ItemsSource="{Binding SystemOptions}" SelectedIndex="{Binding SystemIndex}"
                                      Style="{StaticResource FluentComboBoxStyle}" Grid.Column="1"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Column Section -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Column Section (柱截面)" Style="{StaticResource StrongLabelStyle}" FontSize="14" Margin="0,0,0,12"/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Source:" Style="{StaticResource LabelStyle}" Grid.Column="0"/>
                            <ComboBox ItemsSource="{Binding SourceOptions}" SelectedIndex="{Binding ColumnSourceIndex}"
                                      Style="{StaticResource FluentComboBoxStyle}" Grid.Column="1"/>
                        </Grid>

                        <StackPanel Visibility="{Binding IsColumnDatabase, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Shape:" Style="{StaticResource LabelStyle}" Grid.Column="0"/>
                                <ComboBox ItemsSource="{Binding ColumnShapeOptions}" SelectedIndex="{Binding SelectedColumnShapeIndex}"
                                          Style="{StaticResource FluentComboBoxStyle}" Grid.Column="1"/>
                            </Grid>
                        </StackPanel>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="dc (in):" Style="{StaticResource LabelStyle}" Grid.Column="0"/>
                            <TextBox Text="{Binding Dc, StringFormat=F3}" Style="{StaticResource FluentNumericStyle}"
                                     IsReadOnly="{Binding IsColumnDatabase}" Grid.Column="1" Margin="0,0,8,0"/>
                            <TextBlock Text="bcf (in):" Style="{StaticResource LabelStyle}" Grid.Column="2"/>
                            <TextBox Text="{Binding Bcf, StringFormat=F3}" Style="{StaticResource FluentNumericStyle}"
                                     IsReadOnly="{Binding IsColumnDatabase}" Grid.Column="3"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="tcf (in):" Style="{StaticResource LabelStyle}" Grid.Column="0"/>
                            <TextBox Text="{Binding Tcf, StringFormat=F4}" Style="{StaticResource FluentNumericStyle}"
                                     IsReadOnly="{Binding IsColumnDatabase}" Grid.Column="1" Margin="0,0,8,0"/>
                            <TextBlock Text="tcw (in):" Style="{StaticResource LabelStyle}" Grid.Column="2"/>
                            <TextBox Text="{Binding Tcw, StringFormat=F4}" Style="{StaticResource FluentNumericStyle}"
                                     IsReadOnly="{Binding IsColumnDatabase}" Grid.Column="3"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Fyc (ksi):" Style="{StaticResource LabelStyle}" Grid.Column="0"/>
                            <TextBox Text="{Binding Fyc, StringFormat=F1}" Style="{StaticResource FluentNumericStyle}" Grid.Column="1" Margin="0,0,8,0"/>
                            <TextBlock Text="Ag (in²):" Style="{StaticResource LabelStyle}" Grid.Column="2"/>
                            <TextBox Text="{Binding AgCol, StringFormat=F2}" Style="{StaticResource FluentNumericStyle}"
                                     IsReadOnly="{Binding IsColumnDatabase}" Grid.Column="3"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Beam Left -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Beam Left (左梁)" Style="{StaticResource StrongLabelStyle}" FontSize="14" Margin="0,0,0,12"/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Source:" Style="{StaticResource LabelStyle}" Grid.Column="0"/>
                            <ComboBox ItemsSource="{Binding SourceOptions}" SelectedIndex="{Binding BeamSourceIndex}"
                                      Style="{StaticResource FluentComboBoxStyle}" Grid.Column="1"/>
                        </Grid>

                        <StackPanel Visibility="{Binding IsBeamDatabase, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Shape:" Style="{StaticResource LabelStyle}" Grid.Column="0"/>
                                <ComboBox ItemsSource="{Binding BeamShapeOptions}" SelectedIndex="{Binding SelectedBeamLeftShapeIndex}"
                                          Style="{StaticResource FluentComboBoxStyle}" Grid.Column="1"/>
                            </Grid>
                        </StackPanel>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="db (in):" Style="{StaticResource LabelStyle}" Grid.Column="0"/>
                            <TextBox Text="{Binding DbLeft, StringFormat=F3}" Style="{StaticResource FluentNumericStyle}"
                                     IsReadOnly="{Binding IsBeamDatabase}" Grid.Column="1" Margin="0,0,8,0"/>
                            <TextBlock Text="tfb (in):" Style="{StaticResource LabelStyle}" Grid.Column="2"/>
                            <TextBox Text="{Binding TfbLeft, StringFormat=F4}" Style="{StaticResource FluentNumericStyle}"
                                     IsReadOnly="{Binding IsBeamDatabase}" Grid.Column="3"/>
                        </Grid>

                        <!-- Capacity design inputs (SMF/IMF) -->
                        <StackPanel Visibility="{Binding ShowCapacityInputs, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Zx (in³):" Style="{StaticResource LabelStyle}" Grid.Column="0"/>
                                <TextBox Text="{Binding ZxLeft, StringFormat=F2}" Style="{StaticResource FluentNumericStyle}"
                                         IsReadOnly="{Binding IsBeamDatabase}" Grid.Column="1" Margin="0,0,8,0"/>
                                <TextBlock Text="Fyb (ksi):" Style="{StaticResource LabelStyle}" Grid.Column="2"/>
                                <TextBox Text="{Binding FybLeft, StringFormat=F1}" Style="{StaticResource FluentNumericStyle}" Grid.Column="3"/>
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Ry:" Style="{StaticResource LabelStyle}" Grid.Column="0"/>
                                <TextBox Text="{Binding RyLeft, StringFormat=F2}" Style="{StaticResource FluentNumericStyle}"
                                         IsReadOnly="{Binding IsRyLeftReadOnly}" Grid.Column="1" Margin="0,0,8,0"/>
                                <CheckBox Content="Auto Ry" IsChecked="{Binding AutoRyLeft}" VerticalAlignment="Center" Grid.Column="2"/>
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Cpr:" Style="{StaticResource LabelStyle}" Grid.Column="0"
                                           ToolTip="Cpr = (Fy+Fu)/(2×Fy) ≤ 1.2; use 1.15 for A992."/>
                                <TextBox Text="{Binding CprLeft, StringFormat=F2}" Style="{StaticResource FluentNumericStyle}" Grid.Column="1"/>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Mpr (kip-in):" Style="{StaticResource LabelStyle}" Grid.Column="0"/>
                                <TextBox Text="{Binding MprLeft, StringFormat=F1}" Style="{StaticResource FluentNumericStyle}"
                                         IsReadOnly="True" Grid.Column="1"/>
                            </Grid>
                        </StackPanel>

                        <!-- User input mode (OMF) -->
                        <StackPanel Visibility="{Binding ShowUserMoment, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Mf (kip-in):" Style="{StaticResource LabelStyle}" Grid.Column="0"
                                           ToolTip="Factored beam moment at column face from analysis."/>
                                <TextBox Text="{Binding MprLeft, StringFormat=F1}" Style="{StaticResource FluentNumericStyle}" Grid.Column="1"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Beam Right -->
                <Border Style="{StaticResource CardStyle}" Visibility="{Binding ShowBeamRightCard, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="Beam Right (右梁)" Style="{StaticResource StrongLabelStyle}" FontSize="14" Margin="0,0,0,12"/>

                        <CheckBox Content="Same as Beam Left (同左梁)" IsChecked="{Binding SameBeamRight}"
                                  Margin="0,0,0,8"/>

                        <StackPanel Visibility="{Binding ShowBeamRightInputs, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="db (in):" Style="{StaticResource LabelStyle}" Grid.Column="0"/>
                                <TextBox Text="{Binding DbRight, StringFormat=F3}" Style="{StaticResource FluentNumericStyle}" Grid.Column="1" Margin="0,0,8,0"/>
                                <TextBlock Text="tfb (in):" Style="{StaticResource LabelStyle}" Grid.Column="2"/>
                                <TextBox Text="{Binding TfbRight, StringFormat=F4}" Style="{StaticResource FluentNumericStyle}" Grid.Column="3"/>
                            </Grid>

                            <!-- Capacity design inputs -->
                            <StackPanel Visibility="{Binding ShowCapacityInputs, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Zx (in³):" Style="{StaticResource LabelStyle}" Grid.Column="0"/>
                                    <TextBox Text="{Binding ZxRight, StringFormat=F2}" Style="{StaticResource FluentNumericStyle}" Grid.Column="1" Margin="0,0,8,0"/>
                                    <TextBlock Text="Fyb (ksi):" Style="{StaticResource LabelStyle}" Grid.Column="2"/>
                                    <TextBox Text="{Binding FybRight, StringFormat=F1}" Style="{StaticResource FluentNumericStyle}" Grid.Column="3"/>
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Ry:" Style="{StaticResource LabelStyle}" Grid.Column="0"/>
                                    <TextBox Text="{Binding RyRight, StringFormat=F2}" Style="{StaticResource FluentNumericStyle}"
                                             IsReadOnly="{Binding IsRyRightReadOnly}" Grid.Column="1" Margin="0,0,8,0"/>
                                    <CheckBox Content="Auto Ry" IsChecked="{Binding AutoRyRight}" VerticalAlignment="Center" Grid.Column="2"/>
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Cpr:" Style="{StaticResource LabelStyle}" Grid.Column="0"
                                               ToolTip="Cpr = (Fy+Fu)/(2×Fy) ≤ 1.2; use 1.15 for A992."/>
                                    <TextBox Text="{Binding CprRight, StringFormat=F2}" Style="{StaticResource FluentNumericStyle}" Grid.Column="1"/>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Mpr (kip-in):" Style="{StaticResource LabelStyle}" Grid.Column="0"/>
                                    <TextBox Text="{Binding MprRight, StringFormat=F1}" Style="{StaticResource FluentNumericStyle}"
                                             IsReadOnly="True" Grid.Column="1"/>
                                </Grid>
                            </StackPanel>

                            <!-- User input mode (OMF) -->
                            <StackPanel Visibility="{Binding ShowUserMoment, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Mf (kip-in):" Style="{StaticResource LabelStyle}" Grid.Column="0"/>
                                    <TextBox Text="{Binding MprRight, StringFormat=F1}" Style="{StaticResource FluentNumericStyle}" Grid.Column="1"/>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Joint Parameters -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Joint Parameters (节点参数)" Style="{StaticResource StrongLabelStyle}" FontSize="14" Margin="0,0,0,12"/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Hc (in):" Style="{StaticResource LabelStyle}" Grid.Column="0"
                                       ToolTip="Story height (distance between beam centerlines)."/>
                            <TextBox Text="{Binding Hc, StringFormat=F1}" Style="{StaticResource FluentNumericStyle}" Grid.Column="1" Margin="0,0,8,0"/>
                            <TextBlock Text="Pr (kips):" Style="{StaticResource LabelStyle}" Grid.Column="2"
                                       ToolTip="Required column axial strength at the joint (compression positive)."/>
                            <TextBox Text="{Binding Pr, StringFormat=F1}" Style="{StaticResource FluentNumericStyle}" Grid.Column="3"/>
                        </Grid>

                        <CheckBox Content="Has Right Beam (有右梁 — 内节点)" IsChecked="{Binding HasRightBeam}"
                                  Margin="0,0,0,4"/>
                    </StackPanel>
                </Border>

                <!-- Calculate Button -->
                <Button Content="Start Check" Command="{Binding CalculateCommand}"
                        Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Stretch" Margin="0,0,0,16"/>

                <!-- Results Summary -->
                <Border Style="{StaticResource CardStyle}" Visibility="{Binding HasResult, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="Check Summary" Style="{StaticResource StrongLabelStyle}" FontSize="14" Margin="0,0,0,12"/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Shear Demand: " Style="{StaticResource LabelStyle}" Grid.Column="0"/>
                            <TextBlock Text="{Binding DemandText}" Style="{StaticResource StrongLabelStyle}" Grid.Column="1"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Capacity: " Style="{StaticResource LabelStyle}" Grid.Column="0"/>
                            <TextBlock Text="{Binding CapacityText}" Style="{StaticResource StrongLabelStyle}" Grid.Column="1"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Strength Ratio: " Style="{StaticResource LabelStyle}" Grid.Column="0"/>
                            <TextBlock Text="{Binding StrengthRatioText}" Style="{StaticResource StrongLabelStyle}" Grid.Column="1"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Thickness: " Style="{StaticResource LabelStyle}" Grid.Column="0"/>
                            <TextBlock Text="{Binding ThicknessText}" Style="{StaticResource StrongLabelStyle}" Grid.Column="1"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Doubler Plate: " Style="{StaticResource LabelStyle}" Grid.Column="0"/>
                            <TextBlock Text="{Binding DoublerText}" Style="{StaticResource StrongLabelStyle}" Grid.Column="1"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Plug Welds: " Style="{StaticResource LabelStyle}" Grid.Column="0"/>
                            <TextBlock Text="{Binding PlugWeldText}" Style="{StaticResource StrongLabelStyle}" Grid.Column="1"/>
                        </Grid>

                        <Separator Margin="0,4"/>

                        <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusForeground}"
                                   FontWeight="Bold" FontSize="16" Margin="0,8,0,0"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Right: Detailed Calculation Process -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="16">
            <StackPanel>
                <TextBlock Text="Detailed Calculation Process" Style="{StaticResource SectionTitleStyle}"/>

                <Border Style="{StaticResource CardStyle}">
                    <Border Background="#F5F5F5" BorderBrush="{StaticResource FluentBorderBrush}" BorderThickness="1"
                            CornerRadius="4" Padding="12">
                        <TextBox Text="{Binding ProcessText}"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 MinHeight="600"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 FontFamily="Consolas"
                                 FontSize="13"
                                 VerticalScrollBarVisibility="Auto"/>
                    </Border>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
